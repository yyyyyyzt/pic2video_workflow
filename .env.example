# ============================================================================
# ScailSwap 配置（复制为 .env 后按需修改：cp .env.example .env）
# ============================================================================

# 生成引擎：
#   wan_animate  自托管 Wan2.2-Animate —— 【口播/说话视频推荐】面部表情与口型有
#                专门的条件通路，77 帧窗口 + continue_motion 模型级锚定
#   scail2       自托管 SCAIL-2 —— 复杂 3D 动作、多人交互、非人角色更稳
#   dashscope    阿里云百炼 API —— 见下方 DASHSCOPE_MODEL
#   fal          fal.ai 托管 SCAIL-2 —— 仅 ≤81 帧短片验证
#   fake         无 GPU 调试引擎
SCAILSWAP_ENGINE=wan_animate

# 数据目录（上传、任务状态、分块中间文件、输出）
SCAILSWAP_DATA_DIR=./data

# ---------------------------------------------------------------------------
# 自托管 ComfyUI 连接（wan_animate / scail2 共用）
# ---------------------------------------------------------------------------
COMFYUI_URL=http://127.0.0.1:8188
# 单块推理轮询超时（秒）。Wan2.2-Animate 单块含姿态提取，建议 ≥1800
COMFYUI_CHUNK_TIMEOUT=1800

# ---------------------------------------------------------------------------
# 主引擎 wan_animate：Wan2.2-Animate 模型文件
#（与 setup.sh --with-comfyui 下载的文件对应）
# ---------------------------------------------------------------------------
WANANIMATE_UNET=wan2.2_animate_14B_bf16.safetensors
# 显存 <32GB 改用：WANANIMATE_UNET=wan2.2_animate_14B_int8_convrot.safetensors
WANANIMATE_TEXT_ENCODER=umt5_xxl_fp8_e4m3fn_scaled.safetensors
WANANIMATE_VAE=wan_2.1_vae.safetensors
WANANIMATE_CLIP_VISION=clip_vision_h.safetensors
WANANIMATE_LORA_LIGHTX2V=lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors
# relight LoRA 仅在 replacement（换人）模式生效，让人物融入原场景光照
WANANIMATE_LORA_RELIGHT=wan2.2_animate_14B_relight_lora_bf16.safetensors
# 原生预处理模型（骨架关键点 / 人体检测 / 人物掩码）
WANANIMATE_SDPOSE=sdpose_wholebody_fp16.safetensors
WANANIMATE_RTDETR=rt_detr_v4-x-hgnet_fp16.safetensors
WANANIMATE_SAM3_CKPT=sam3.1_multiplex_fp16.safetensors
# 姿态提取的批大小（显存紧张时降到 8）
WANANIMATE_POSE_BATCH=16

# ---------------------------------------------------------------------------
# 阿里云百炼 API（engine=dashscope）
# ---------------------------------------------------------------------------
# DASHSCOPE_API_KEY=sk-xxxx
#
# DASHSCOPE_MODEL 决定锚定能力与时长上限：
#   wan2.2-animate-mix   视频换人，2~30s，【无跨块锚定】→ 只能单块，长视频会被拒
#   wan2.2-animate-move  动作迁移，2~30s，【无跨块锚定】
#   wan2.7-videoedit     通用视频编辑，2~10s，【参考级弱锚定】→ 支持长视频（实验性）
#                        原理：把上一块输出末帧作为附加参考图（最多 4 张）传入
DASHSCOPE_MODEL=wan2.2-animate-mix
# animate 系列服务模式：wan-pro(25fps，效果好) / wan-std(15fps，便宜)
# 注意：服务端固定输出帧率，processor 会按 target_fps 自动重采样
DASHSCOPE_SERVICE_MODE=wan-pro
DASHSCOPE_RESOLUTION=720P
DASHSCOPE_WATERMARK=false
# 素材寻址：配置公网静态目录可避免 base64 体积上限（大视频必配）
# DASHSCOPE_PUBLIC_BASE_URL=https://your-cdn.example.com/scailswap
# DASHSCOPE_PUBLIC_ROOT=./data

# ---------------------------------------------------------------------------
# 备选引擎 scail2：SCAIL-2 模型文件（engine=scail2 时生效）
# ---------------------------------------------------------------------------
# SCAILSWAP_UNET=wan2.1_14B_SCAIL_2_fp8_scaled.safetensors
# SCAILSWAP_TEXT_ENCODER=umt5_xxl_fp8_e4m3fn_scaled.safetensors
# SCAILSWAP_VAE=wan_2.1_vae.safetensors
# SCAILSWAP_CLIP_VISION=clip_vision_h.safetensors
# SCAILSWAP_LORA_LIGHTX2V=lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors
# SCAILSWAP_LORA_DPO=wan2.1_SCAIL_2_DPO_lora_bf16.safetensors
# SCAILSWAP_SAM3_CKPT=sam3.1_multiplex_fp16.safetensors

# ---------------------------------------------------------------------------
# fal.ai 托管 API（engine=fal，仅 ≤81 帧短片；不支持长视频锚定）
# ---------------------------------------------------------------------------
# FAL_KEY=your-fal-api-key

# ---------------------------------------------------------------------------
# Wav2Lip 口型精修（可选后处理，setup.sh --with-wav2lip 安装）
# ---------------------------------------------------------------------------
# WAV2LIP_DIR=./Wav2Lip
# WAV2LIP_CHECKPOINT=./Wav2Lip/checkpoints/wav2lip_gan.pth

# ---------------------------------------------------------------------------
# API 服务
# ---------------------------------------------------------------------------
SCAILSWAP_HOST=0.0.0.0
SCAILSWAP_PORT=8000

# ===========================================================================
# ↓↓↓ 以下为 legacy（roleswap 远程工作流封装，已被上方新架构取代）↓↓↓
# ===========================================================================
# ROLESWAP_BASE_URL=https://your-comfy-host.example.com
# ROLESWAP_WORKFLOW_ID=K11-SCAIL2动作迁移-角色替换-支持长视频-像素幻想Lab
# ROLESWAP_API_KEY=
