# 把这个文件复制成 .env 再填。.env 已经在 .gitignore 里，不会被提交。
#   cp .env.example .env

# ==========================================================================
# WaveSpeedAI（主通道，海外）
# ==========================================================================
# https://wavespeed.ai 控制台创建，形如 wsk_live_xxxx
# 一个 Key 覆盖 SkyReels / InfiniteTalk / OmniHuman / Wan2.2-Animate / 超分
WAVESPEED_API_KEY=wsk_live_xxxxxxxx
# WAVESPEED_API_BASE=https://api.wavespeed.ai


# ==========================================================================
# 模力方舟 Gitee AI（国内通道）
# ==========================================================================
# https://ai.gitee.com 工作台 → 设置 → 访问令牌
# 注意 base 是 ai.gitee.com，不是 api.moark.com（后者不通，实测踩过）
MOARK_API_KEY=
# MOARK_API_BASE=https://ai.gitee.com/v1


# ==========================================================================
# 客观评测用的模型目录（可选）
# ==========================================================================
# 人脸/体态模型默认下到 data/models/，首次运行自动拉。
# 想放到共享目录就改这个：
# AVATAR_MODEL_DIR=/opt/avatar-models
