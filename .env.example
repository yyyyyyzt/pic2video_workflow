# ==========================================================================
# 可灵（kling_avatar.py / server.py）
# ==========================================================================

# 方式 A（推荐，新版控制台）：单个 API Key，直接 Bearer 透传
# 形如 api-key-kling-xxxx
KLING_API_KEY=api-key-kling-xxxxxxxx

# 方式 B（旧版）：AccessKey + SecretKey，脚本会签发 JWT
# 注意：AK 和 SK 是两把不同的钥匙；如果你拿到的是同一个 api-key-kling-xxx，
# 请用方式 A，不要走 JWT（否则会 401 access key not found）
# KLING_ACCESS_KEY=your_access_key
# KLING_SECRET_KEY=your_secret_key

# 国内默认 api-beijing；海外账号用 api-singapore（密钥不跨区通用）
KLING_API_BASE=https://api-beijing.klingai.com
# KLING_API_BASE=https://api-singapore.klingai.com


# ==========================================================================
# WaveSpeedAI（avatar_lab.py 主通道，海外）
# ==========================================================================
# https://wavespeed.ai 控制台创建，形如 wsk_live_xxxx
# 一个 Key 覆盖 InfiniteTalk / OmniHuman / Wan2.2-Animate / sync lipsync / 超分
WAVESPEED_API_KEY=wsk_live_xxxxxxxx
# WAVESPEED_API_BASE=https://api.wavespeed.ai


# ==========================================================================
# 模力方舟 Gitee AI（avatar_lab.py 国内通道）
# ==========================================================================
# https://moark.com 工作台 → 设置 → 访问令牌
# 国内节点，同时有 InfiniteTalk 和 Duix-Avatar
MOARK_API_KEY=
# MOARK_API_BASE=https://api.moark.com
